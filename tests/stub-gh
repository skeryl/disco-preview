#!/usr/bin/env bash
# Stub gh. Open PRs come from $STUB_OPEN_PRS (space separated).
set -euo pipefail
printf '%s\n' "gh $*" >> "$STUB_CALLS"
if [ "${1:-}" = "pr" ] && [ "${2:-}" = "list" ]; then
  for n in ${STUB_OPEN_PRS:-}; do echo "$n"; done
  exit 0
fi
if [ "${1:-}" = "pr" ] && [ "${2:-}" = "view" ]; then
  n="${3:-}"
  if printf '%s\n' "$@" | grep -q "headRefOid"; then
    if [ "${STUB_GH_VIEW_FAILS:-}" = "1" ]; then echo "api down" >&2; exit 1; fi
    echo "${STUB_PR_HEAD:-deadbeef}"; exit 0
  fi
  if [ "${STUB_GH_VIEW_FAILS:-}" = "1" ]; then
    echo "API rate limit exceeded" >&2; exit 1
  fi
  for o in ${STUB_OPEN_PRS:-}; do
    if [ "$o" = "$n" ]; then echo "OPEN"; exit 0; fi
  done
  echo "${STUB_CLOSED_STATE:-CLOSED}"; exit 0
fi
if [ "${1:-}" = "pr" ] && [ "${2:-}" = "comment" ]; then
  if printf '%s\n' "$@" | grep -qx -- "--edit-last" && [ "${STUB_NO_PRIOR_COMMENT:-1}" = "1" ]; then
    echo "no comment found to edit" >&2; exit 1
  fi
  exit 0
fi
echo "STUB: unhandled gh: $*" >&2; exit 90
